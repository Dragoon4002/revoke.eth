# ============================================================
# ETHEREUM / SEPOLIA
# ============================================================

# Deployer wallet private key (no 0x prefix)
PRIVATE_KEY=

# Alchemy Sepolia RPC — https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Deployed contract addresses (filled after Deploy.s.sol)
CAPABILITY_REGISTRY=0x70a15Db526104abC2f021b7c690cd89a07EDE49C
AGENT_RESOLVER=0xeeb56334152D6bDB62aacF56f8DbCceA5210b78D
AGENT_REGISTRAR=0x2A9caFEDFc91d55E00B6d1514E39BeB940832b5D

# ============================================================
# THE GRAPH
# ============================================================

# Subgraph Studio deploy key — thegraph.com/studio → your subgraph → Deploy Key
GRAPH_DEPLOY_KEY=

# Subgraph query URL — filled after first deploy
# Format: https://api.studio.thegraph.com/query/<id>/revoke-ens/v0.0.1
GRAPH_QUERY_URL=

# ============================================================
# HEDERA TESTNET
# ============================================================

# Hedera account ID — format: 0.0.XXXXXX
HEDERA_ACCOUNT_ID=

# Hedera account private key (ED25519 or ECDSA)
HEDERA_PRIVATE_KEY=

# HCS topic ID for audit trail (created on first run)
HEDERA_TOPIC_ID=

# ============================================================
# X402 PAYMENT (direct — no Blocky402)
# ============================================================

# ERC-20 token address on Hedera testnet for payment (USDC or wrapped HBAR)
X402_TOKEN_ADDRESS=

# Address that receives payments (your service wallet)
X402_PAY_TO_ADDRESS=

# Payment amount in token base units (e.g. 1000000 = 1 USDC)
X402_AMOUNT=1000000
