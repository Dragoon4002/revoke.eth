# Copy to .env and fill in values

# Your deployer wallet private key (no 0x prefix)
# Get from: MetaMask → Account Details → Export Private Key
PRIVATE_KEY=

# Sepolia RPC URL
# Get from: https://dashboard.alchemy.com → Create App → Ethereum Sepolia → API Key
# Format: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=

# Etherscan API key for contract verification
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- Filled in AFTER running Deploy.s.sol ---
# These are output by the deploy script; paste them here for RegisterDemoAgent script
AGENT_REGISTRAR=
AGENT_RESOLVER=
CAPABILITY_REGISTRY=
